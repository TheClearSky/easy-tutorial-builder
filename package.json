{
  "name": "@theclearsky/easy-tutorial-builder",
  "version": "0.0.1",
  "description": "Interactive, fault-tolerant product tours as typed, data-only scripts: event-driven steps, pan/zoom-aware spotlight, remote launch over postMessage.",
  "license": "MIT",
  "author": "Deepak Prasad <TheClearSky@github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClearSky/easy-tutorial-builder.git"
  },
  "keywords": [
    "tutorial",
    "tour",
    "onboarding",
    "walkthrough",
    "spotlight",
    "react",
    "typescript",
    "zod",
    "postmessage"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./remote": {
      "types": "./dist/remote/index.d.ts",
      "import": "./dist/remote.js",
      "require": "./dist/remote.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node --experimental-strip-types scripts/check-dist.ts",
    "type-check": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "pretty": "prettier --write .",
    "pretty:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^4.1.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "zod": "^4.6.5"
  }
}
